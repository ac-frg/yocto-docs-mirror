import argparse
import os
import re
import textwrap

from pathlib import Path


YOCTO_DOCS_URL = "https://docs.yoctoproject.org"
DOCS_DIR = Path(os.path.dirname(os.path.realpath(__file__))) / "../"
PREAMBLE = """#
# This file is automatically generated with tools/gen-doc-links, do not edit manually.
#

"""


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Generate glossaries from Sphinx text output")

    parser.add_argument("-o", "--output",
                        type=Path,
                        default=DOCS_DIR / "oecore/doclinks.conf",
                        help="Output links.conf file")

    return parser.parse_args()


def doclink(dir: Path, name: str) -> str:
    dirpath = dir.relative_to(DOCS_DIR)
    return f"{name}[doclink] = '{YOCTO_DOCS_URL}/${{LAYERSERIES_COMPAT_core}}/{dirpath}.html#term-{name}'\n"


def main():
    args = parse_arguments()
    variables_dir = DOCS_DIR / "ref-manual/variables/"
    tasks_dir = DOCS_DIR / "ref-manual/tasks/"
    with open(args.output, "w") as links_conf:
        links_conf.write(PREAMBLE)
        for d in (variables_dir, tasks_dir):
            for txtfile in sorted([Path(t) for t in os.listdir(d)]):
                links_conf.write(doclink(d, txtfile.stem))


if __name__ == "__main__":
    main()

